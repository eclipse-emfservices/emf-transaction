<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.eclipse.emf.transaction</groupId>
        <artifactId>org.eclipse.emf.transaction.releng</artifactId>
        <version>1.14.3-SNAPSHOT</version>
        <relativePath>../../releng/org.eclipse.emf.transaction.releng/pom.xml</relativePath>
    </parent>
    <groupId>org.eclipse.emf.transaction.plugins</groupId>
    <artifactId>org.eclipse.emf.transaction.tests</artifactId>
    <version>1.12.0-SNAPSHOT</version>
    <packaging>eclipse-test-plugin</packaging>
    <profiles>
        <profile>
            <id>macosx</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <properties>
                <test.additionalvmargs>-XstartOnFirstThread</test.additionalvmargs>
            </properties>
        </profile>
        <profile>
            <id>other-os</id>
            <activation>
                <os>
                    <family>!mac</family>
                </os>
            </activation>
            <properties>
                <test.additionalvmargs></test.additionalvmargs>
            </properties>
        </profile>
    </profiles>
    <build>
        <plugins>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-surefire-plugin</artifactId>
                <version>${tycho-version}</version>
                <configuration>
                    <useUIHarness>true</useUIHarness>
                    <useUIThread>true</useUIThread>
                    <product>org.eclipse.sdk.ide</product>
                    <argLine>-ea -Xmx1024m ${test.additionalvmargs}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
